<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php" cacheResult="false">
  <php>
    <ini name="error_reporting" value="-1"/>
    <ini name="memory_limit" value="4G"/>
    <server name="KERNEL_CLASS" value="Shopware\Core\Kernel"/>
    <env name="APP_ENV" value="test"/>
    <env name="APP_DEBUG" value="1"/>
    <env name="APP_SECRET" value="s$cretf0rt3st"/>
    <env name="DATABASE_URL" value="mysql://root:root@127.0.0.1:3309/shopware"/>
    <env name="SHELL_VERBOSITY" value="-1"/>
    <env name="LOCK_DSN" value="flock"/>
  </php>
  <testsuites>
    <testsuite name="Nosto Tests">
      <directory>tests/</directory>
    </testsuite>
  </testsuites>
  <source>
    <include>
      <directory suffix=".php">./</directory>
    </include>
  </source>
</phpunit>
