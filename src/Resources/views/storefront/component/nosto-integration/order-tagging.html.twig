{% block nosto_integration_order_tagging %}

    {% set order = page.order %}
    {% set sendCustomerData = context.context.extensions.nostoConfig.sendCustomerData %}
    {% set productIdentifier = context.context.extensions.nostoConfig.productIdentifier %}

    {% if order %}
        <div class="nosto_purchase_order" style="display:none">
            <span class="order_number" translate="no">{{ order.orderNumber }}</span>

            {% if sendCustomerData %}
                <div class="buyer">
                    <span class="email" translate="no">{{ order.orderCustomer.email }}</span>
                    <span class="first_name" translate="no">{{ order.orderCustomer.firstName }}</span>
                    <span class="last_name" translate="no">{{ order.orderCustomer.lastName }}</span>
                    <span class="marketing_permission">false</span>
                </div>
            {% endif %}

            <span class="payment_provider" translate="no">{{ order.transactions.first.paymentMethod.name }}</span>
            <span class="order_status_code" translate="no">{{ order.stateMachineState.technicalName }}</span>

            <div class="purchased_items">
                {% for lineItem in order.lineItems %}
                    {% if lineItem.type == 'product' %}
                        <div class="line_item">
                            <span class="product_id" translate="no">
                                    {% if lineItem.payload.parentId != null %}
                                        {% set productId = nosto_shopware_main_product_identifier(lineItem.payload.parentId, lineItem.referencedId, context) %}
                                        {{ productId }}
                                    {% else %}
                                        {% if productIdentifier == 'product-number' %}
                                            {{ lineItem.payload.productNumber }}
                                        {% else %}
                                            {{ lineItem.referencedId }}
                                        {% endif %}
                                    {% endif %}
                            </span>
                            <span class="quantity" translate="no">{{ lineItem.quantity }}</span>
                            <span class="name" translate="no">{{ lineItem.label }}</span>
                            <span class="unit_price" translate="no">{{ lineItem.unitPrice }}</span>
                            <span class="price_currency_code" translate="no">{{ context.currency.isoCode }}</span>
                            <span class="sku_id" translate="no">
                                {% if productIdentifier == 'product-number' %}
                                    {{ lineItem.payload.productNumber }}
                                {% else %}
                                    {{ lineItem.referencedId }}
                                {% endif %}
                            </span>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    {% endif %}

{% endblock %}
