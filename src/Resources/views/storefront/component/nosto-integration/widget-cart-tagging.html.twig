{% block nosto_integration_cart_tagging %}

    {% set nostoConfigurationValues = nosto_configuration_values(context) %}
    {% set productIdentifier = nostoConfigurationValues.productIdentifier %}

    <div class="nosto_cart" style="display:none">
        {% for lineItem in  page.cart.lineItems %}
            {% if lineItem.type == 'product' %}
                <div class="line_item">
                    <span class="product_id">
                        {% if productIdentifier == 'product-number' %}
                            {% if lineItem.payload.parentId != null %}
                                {% set nostoProduct = nosto_shopware_product_by_id(lineItem.payload.parentId, context) %}
                                {{ nostoProduct.productNumber }}
                            {% else %}
                                {{ lineItem.payload.productNumber }}
                            {% endif %}
                        {% else %}
                            {% if lineItem.payload.parentId != null %}
                                {{ lineItem.payload.parentId }}
                            {% else %}
                                {{ lineItem.referencedId }}
                            {% endif %}
                        {% endif %}
                    </span>
                    <span class="quantity">{{ lineItem.quantity }}</span>
                    <span class="name">{{ lineItem.label }}</span>
                    <span class="unit_price">{{ lineItem.price.unitPrice }}</span>
                    <span class="price_currency_code">{{ context.currency.isoCode }}</span>
                    <span class="sku_id">
                        {% if productIdentifier == 'product-number' %}
                            {{ lineItem.payload.productNumber }}
                        {% else %}
                            {{ lineItem.referencedId }}
                        {% endif %}
                    </span>
                </div>
            {% endif %}
        {% endfor %}
        {% set restoreLink = nosto_restore_cart_link(context) %}
        <div class="restore_link">{{ restoreLink }}</div>
    </div>
{% endblock %}
