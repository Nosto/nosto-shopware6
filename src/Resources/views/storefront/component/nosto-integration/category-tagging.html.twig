{% block nosto_integration_category_tagging %}

    {% set category = page.header.navigation.active %}

    {% if category %}

        {% set nostoCategory = nosto_category(category, context) %}

        <span class="nosto_category" style="display:none">
            <span class="id" translate="no">{{ nostoCategory.id }}</span>
            <span class="parent_id" translate="no">{{ nostoCategory.parentId }}</span>
            <span class="title" translate="no">{{ nostoCategory.title }}</span>
            <span class="url" translate="no">{{ nostoCategory.url }}</span>
            <span class="path" translate="no">{{ nostoCategory.path }}</span>
            <span class="available" translate="no">{{ nostoCategory.available }}</span>
            <span class="category_string" translate="no">{{ nostoCategory.categoryString }}</span>
        </span>
    {% endif %}

{% endblock %}