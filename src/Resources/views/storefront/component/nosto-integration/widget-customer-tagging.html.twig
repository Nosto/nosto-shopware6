{% block nosto_integration_customer_tagging %}

    {% set isSendCustomerData = context.context.extensions.nostoConfig.sendCustomerData %}

    {% if isSendCustomerData and context.customer %}
        {% set customer = nosto_customer(context.customer, context.context) %}

        {% if customer %}
            <div class="nosto_customer" style="display:none">
                <span class="email" translate="no">{{ customer.email }}</span>
                <span class="first_name" translate="no">{{ customer.firstName }}</span>
                <span class="last_name" translate="no">{{ customer.lastName }}</span>
                <span class="customer_reference" translate="no">{{ customer.customerReference }}</span>
                <span class="marketing_permission" translate="no">{% if customer.marketingPermission %}true{% else %}false{% endif %}</span>
            </div>
        {% endif %}
    {% endif %}

{% endblock %}
