{% sw_extends '@Storefront/storefront/component/pagination.html.twig' %}

{% block component_pagination_nav %}
    {% if not context.context.extensions.nostoService.enabled %}
        {{ parent() }}
    {% else %}
        {% if not (searchResult.criteria.extensions.nostoPagination) %}
            {% set currentPage = criteria.limit > 0 ? ((criteria.offset + 1) / criteria.limit )|round(0, 'ceil') : 1 %}
            {% set totalPages = criteria.limit > 0 ? (entities.total / criteria.limit)|round(0, 'ceil') : 1 %}
        {% else %}
            {% set currentPage = searchResult.criteria.extensions.nostoPagination.limit > 0 ? ((searchResult.criteria.extensions.nostoPagination.offset + 1) / searchResult.criteria.extensions.nostoPagination.limit )|round(0, 'ceil') : 1 %}
            {% set totalPages = searchResult.criteria.extensions.nostoPagination.limit > 0 ? (searchResult.criteria.extensions.nostoPagination.total / searchResult.criteria.extensions.nostoPagination.limit)|round(0, 'ceil') : 1 %}
        {% endif %}

        {% set paginationSuffix = '' %}
        {% if paginationLocation %}
            {% set paginationSuffix = '-' ~ paginationLocation %}
        {% endif %}

        {% if totalPages > 1 %}
            <nav aria-label="pagination" class="pagination-nav">
                {% block component_pagination %}
                    {{ parent() }}
                {% endblock %}
            </nav>
        {% endif %}
    {% endif %}
{% endblock %}
