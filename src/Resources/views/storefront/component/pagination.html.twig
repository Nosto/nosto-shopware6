{% sw_extends '@Storefront/storefront/component/pagination.html.twig' %}

{% block component_pagination_nav %}
    {% if not context.context.extensions.nostoService.enabled %}
        {{ parent() }}
    {% else %}
        {% if not (searchResult.criteria.extensions.nostoPagination) %}
            {% set currentPage = entities.page %}
            {% set totalPages = (entities.total / (entities.limit ?: 1))|round(0, 'ceil') %}
        {% else %}
            {% set paginationLimit = searchResult.criteria.extensions.nostoPagination.limit %}
            {% set currentPage = paginationLimit > 0 ? ((searchResult.criteria.extensions.nostoPagination.offset + 1) / paginationLimit)|round(0, 'ceil') : 1 %}
            {% set totalPages = paginationLimit > 0 ? (searchResult.criteria.extensions.nostoPagination.total / paginationLimit)|round(0, 'ceil') : 0 %}
        {% endif %}

        {% set paginationSuffix = '' %}
        {% if paginationLocation %}
            {% set paginationSuffix = '-' ~ paginationLocation %}
        {% endif %}

        {% if totalPages > 1 %}
            <nav aria-label="pagination" class="pagination-nav">
                {% block component_pagination %}
                    {{ parent() }}
                {% endblock %}
            </nav>
        {% endif %}
    {% endif %}
{% endblock %}
