{% extends '@Storefront/storefront/base.html.twig' %}

{% block base_body %}
    <div class="nosto-layout" style="display: flex; flex-direction: column;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h2 style="margin: 0; color: #6c757d;">Nosto Monitoring (v: {{ nostoVersion }})</h2>
            <form action="{{ path('nosto-monitoring.logout') }}" method="POST" style="margin: 0;">
                <button type="submit" class="nosto-button" style="background: #dc3545; padding: 8px 16px;">
                    Logout
                </button>
            </form>
        </div>
        <div class="nosto-context-selectors" style="background: white; border: 1px solid #dee2e6; border-radius: 8px; padding: 20px; margin-bottom: 20px;">
            <h3 style="margin: 0 0 15px 0; color: #6c757d; font-size: 18px;">Context Selection</h3>
            <form method="GET" action="{{ path('nosto-monitoring.manage-operations') }}">
                <div style="display: flex; gap: 20px; flex-wrap: wrap;">
                    <!-- Language Dropdown -->
                    <div style="flex: 1; min-width: 200px;">
                        <label for="languageId" style="display: block; margin-bottom: 8px; color: #8b5cf6; font-weight: 500;">Language</label>
                        <select name="languageId" style="width: 100%; padding: 10px 15px; border: 1px solid #dee2e6; border-radius: 6px; background: white; font-size: 14px; color: #495057;">
                            <option value="">All Languages</option>
                            {% for language in languages %}
                                <option value="{{ language.id }}" {% if language.id == currentLanguageId %}selected{% endif %}>
                                    {{ language.locale.name }} ({{ language.locale.code }})
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <!-- Sales Channel Dropdown -->
                    <div style="flex: 1; min-width: 200px;">
                        <label for="salesChannelId" style="display: block; margin-bottom: 8px; color: #8b5cf6; font-weight: 500;">Sales Channel</label>
                        <select name="salesChannelId" style="width: 100%; padding: 10px 15px; border: 1px solid #dee2e6; border-radius: 6px; background: white; font-size: 14px; color: #495057;">
                            <option value="">All Sales Channels</option>
                            {% for salesChannel in salesChannels %}
                                <option value="{{ salesChannel.id }}" {% if salesChannel.id == currentSalesChannelId %}selected{% endif %}>
                                    {{ salesChannel.name }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <!-- Submit Button -->
                    <div style="display: flex; align-items: end;">
                        <button type="submit" class="nosto-button" style="padding: 10px 20px; background: #8b5cf6; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: 500;">
                            Apply Context
                        </button>
                    </div>
                </div>
            </form>

            <!-- Current Context Display -->
            {% if currentLanguageId or currentSalesChannelId %}
                <div style="margin-top: 15px; padding-top: 15px; border-top: 1px solid #f0f0f0;">
                    <div style="display: flex; gap: 20px; font-size: 14px; color: #6c757d; flex-wrap: wrap;">
                        {% if currentLanguageId %}
                            <span><strong>Active Language:</strong>
                                    {% for language in languages %}
                                        {% if language.id == currentLanguageId %}
                                            {{ language.locale.name }} ({{ language.locale.code }})
                                        {% endif %}
                                    {% endfor %}
                                </span>
                        {% endif %}
                        {% if currentSalesChannelId %}
                            <span><strong>Active Sales Channel:</strong>
                                    {% for salesChannel in salesChannels %}
                                        {% if salesChannel.id == currentSalesChannelId %}
                                            {{ salesChannel.name }}
                                        {% endif %}
                                    {% endfor %}
                                </span>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        </div>
        <div class="nosto-main">
            <div class="flash-messages">
                {% for type, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="nosto-message nosto-{{ type }}">
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endfor %}
            </div>
            <div id="nosto-success-message" class="nosto-message" style="display: none;">
                Success message! Green color modern
            </div>
        </div>
        <form id="nosto-clear-form" action="{{ path('nosto-monitoring.clear-jobs') }}" method="POST">
            <button type="submit" class="nosto-button">Clear Nosto Jobs</button>
        </form>

        <!-- Nosto Configuration Display -->
        <div style="background: white; border: 1px solid #dee2e6; border-radius: 8px; margin-bottom: 20px;">

            <!-- Personalized Search & Category Merchandising -->
            <div style="border-bottom: 1px solid #f0f0f0; padding: 20px;">
                <h3 style="margin: 0 0 20px 0; color: #6c757d; font-size: 18px;">Personalized Search & Category Merchandising</h3>
                <div style="margin-bottom: 15px;">
                    <div style="display: flex; align-items: center;">
                        <span style="display: inline-block; width: 12px; height: 12px; border-radius: 50%; background-color: {% if nostoConfig.enablePersonalizedSearch %}#28a745{% else %}#6c757d{% endif %}; margin-right: 10px;"></span>
                        <span style="color: #8b5cf6;">Enable Personalized Search</span>
                        <span style="margin-left: auto; color: {% if nostoConfig.enablePersonalizedSearch %}#28a745{% else %}#6c757d{% endif %}; font-weight: 500;">
                    {% if nostoConfig.enablePersonalizedSearch %}Enabled{% else %}Disabled{% endif %}
                </span>
                    </div>
                </div>
                <div>
                    <div style="display: flex; align-items: center;">
                        <span style="display: inline-block; width: 12px; height: 12px; border-radius: 50%; background-color: {% if nostoConfig.enableCategoryMerchandising %}#28a745{% else %}#6c757d{% endif %}; margin-right: 10px;"></span>
                        <span style="color: #8b5cf6;">Enable Category Merchandising</span>
                        <span style="margin-left: auto; color: {% if nostoConfig.enableCategoryMerchandising %}#28a745{% else %}#6c757d{% endif %}; font-weight: 500;">
                    {% if nostoConfig.enableCategoryMerchandising %}Enabled{% else %}Disabled{% endif %}
                </span>
                    </div>
                </div>
            </div>

            <!-- General settings -->
            <div style="border-bottom: 1px solid #f0f0f0; padding: 20px;">
                <h3 style="margin: 0 0 20px 0; color: #6c757d; font-size: 18px;">General settings</h3>
                <div style="display: flex; align-items: center;">
                    <span style="display: inline-block; width: 12px; height: 12px; border-radius: 50%; background-color: {% if nostoConfig.initializeNostoAfterInteraction %}#28a745{% else %}#6c757d{% endif %}; margin-right: 10px;"></span>
                    <span style="color: #8b5cf6;">Initialize Nosto Script After First Page Iteration</span>
                    <span style="margin-left: auto; color: {% if nostoConfig.initializeNostoAfterInteraction %}#28a745{% else %}#6c757d{% endif %}; font-weight: 500;">
                {% if nostoConfig.initializeNostoAfterInteraction %}Enabled{% else %}Disabled{% endif %}
            </span>
                </div>
            </div>

            <!-- Tags assignment -->
            <div style="border-bottom: 1px solid #f0f0f0; padding: 20px;">
                <h3 style="margin: 0 0 20px 0; color: #6c757d; font-size: 18px;">Tags assignment</h3>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                    <div>
                        <div style="margin-bottom: 15px;">
                            <label style="color: #007bff; font-weight: 500; display: block; margin-bottom: 8px;">Custom Fields</label>
                            <div style="padding: 8px 12px; border: 1px solid #e9ecef; border-radius: 4px; background: #f8f9fa; color: {% if nostoConfig.selectedCustomFields|length > 0 %}#495057{% else %}#6c757d{% endif %};">
                                {% if nostoConfig.selectedCustomFields|length > 0 %}
                                    {{ nostoConfig.selectedCustomFields|join(', ') }}
                                {% else %}
                                    Not configured
                                {% endif %}
                            </div>
                        </div>

                        <div style="margin-bottom: 15px;">
                            <label style="color: #007bff; font-weight: 500; display: block; margin-bottom: 8px;">Tag 1</label>
                            <div style="padding: 8px 12px; border: 1px solid #e9ecef; border-radius: 4px; background: #f8f9fa; color: {% if nostoConfig.tag1|length > 0 %}#495057{% else %}#6c757d{% endif %};">
                                {% if nostoConfig.tag1|length > 0 %}
                                    {{ nostoConfig.tag1|join(', ') }}
                                {% else %}
                                    Not configured
                                {% endif %}
                            </div>
                        </div>

                        <div>
                            <label style="color: #007bff; font-weight: 500; display: block; margin-bottom: 8px;">Tag 2</label>
                            <div style="padding: 8px 12px; border: 1px solid #e9ecef; border-radius: 4px; background: #f8f9fa; color: {% if nostoConfig.tag2|length > 0 %}#495057{% else %}#6c757d{% endif %};">
                                {% if nostoConfig.tag2|length > 0 %}
                                    {{ nostoConfig.tag2|join(', ') }}
                                {% else %}
                                    Not configured
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    <div>
                        <div style="margin-bottom: 15px;">
                            <label style="color: #007bff; font-weight: 500; display: block; margin-bottom: 8px;">Tag 3</label>
                            <div style="padding: 8px 12px; border: 1px solid #e9ecef; border-radius: 4px; background: #f8f9fa; color: {% if nostoConfig.tag3|length > 0 %}#495057{% else %}#6c757d{% endif %};">
                                {% if nostoConfig.tag3|length > 0 %}
                                    {{ nostoConfig.tag3|join(', ') }}
                                {% else %}
                                    Not configured
                                {% endif %}
                            </div>
                        </div>

                        <div>
                            <label style="color: #007bff; font-weight: 500; display: block; margin-bottom: 8px;">Google category</label>
                            <div style="padding: 8px 12px; border: 1px solid #e9ecef; border-radius: 4px; background: #f8f9fa; color: {% if nostoConfig.googleCategory %}#495057{% else %}#6c757d{% endif %};">
                                {% if nostoConfig.googleCategory %}
                                    {{ nostoConfig.googleCategory }}
                                {% else %}
                                    Not configured
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Features flags -->
            <div style="border-bottom: 1px solid #f0f0f0; padding: 20px;">
                <h3 style="margin: 0 0 20px 0; color: #6c757d; font-size: 18px;">Features flags</h3>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                    <div>
                        <div style="margin-bottom: 15px;">
                            <label style="color: #8b5cf6; font-weight: 500; display: block; margin-bottom: 8px;">Product Identifier<span style="color: red;">*</span></label>
                            <div style="padding: 8px 12px; border: 1px solid #e9ecef; border-radius: 4px; background: #f8f9fa;">
                                {{ nostoConfig.productIdentifier|replace({'-': ' '})|title }}
                            </div>
                        </div>

                        <div style="margin-bottom: 15px;">
                            <label style="color: #8b5cf6; font-weight: 500; display: block; margin-bottom: 8px;">Enable Ratings & Reviews<span style="color: red;">*</span></label>
                            <div style="padding: 8px 12px; border: 1px solid #e9ecef; border-radius: 4px; background: #f8f9fa;">
                                {{ nostoConfig.ratingsReviews|replace({'-': ' '})|title }}
                            </div>
                        </div>

                        <div>
                            <label style="color: #8b5cf6; font-weight: 500; display: block; margin-bottom: 8px;">Stock Field<span style="color: red;">*</span></label>
                            <div style="padding: 8px 12px; border: 1px solid #e9ecef; border-radius: 4px; background: #f8f9fa;">
                                {{ nostoConfig.stockField|replace({'-': ' '})|title }}
                            </div>
                        </div>
                    </div>

                    <div>
                        <div style="margin-bottom: 15px;">
                            <label style="color: #8b5cf6; font-weight: 500; display: block; margin-bottom: 8px;">Cross-Selling Synchronization<span style="color: red;">*</span></label>
                            <div style="padding: 8px 12px; border: 1px solid #e9ecef; border-radius: 4px; background: #f8f9fa;">
                                {{ nostoConfig.crossSellingSync|replace({'-': ' '})|title }}
                            </div>
                        </div>

                        <div style="margin-bottom: 15px;">
                            <label style="color: #8b5cf6; font-weight: 500; display: block; margin-bottom: 8px;">Product Category Names<span style="color: red;">*</span></label>
                            <div style="padding: 8px 12px; border: 1px solid #e9ecef; border-radius: 4px; background: #f8f9fa;">
                                {{ nostoConfig.categoryNaming|replace({'-': ' '})|title }}
                            </div>
                        </div>

                        <div>
                            <label style="color: #6c757d; font-weight: 500; display: block; margin-bottom: 8px;">Category Exclusion</label>
                            <div style="padding: 8px 12px; border: 1px solid #e9ecef; border-radius: 4px; background: #f8f9fa; color: {% if nostoConfig.categoryBlocklist|length > 0 %}#495057{% else %}#6c757d{% endif %};">
                                {% if nostoConfig.categoryBlocklist|length > 0 %}
                                    {{ nostoConfig.categoryBlocklist|join(', ') }}
                                {% else %}
                                    Not configured
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Toggle Features Status -->
            <div style="padding: 20px;">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <div style="display: flex; align-items: center;">
                            <span style="display: inline-block; width: 12px; height: 12px; border-radius: 50%; background-color: {% if nostoConfig.enableVariations %}#28a745{% else %}#6c757d{% endif %}; margin-right: 10px;"></span>
                            <span style="color: #8b5cf6;">Enable variations</span>
                        </div>
                        <span style="color: {% if nostoConfig.enableVariations %}#28a745{% else %}#6c757d{% endif %}; font-weight: 500;">
                    {% if nostoConfig.enableVariations %}Enabled{% else %}Disabled{% endif %}
                </span>
                    </div>

                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <div style="display: flex; align-items: center;">
                            <span style="display: inline-block; width: 12px; height: 12px; border-radius: 50%; background-color: {% if nostoConfig.enableProductProperties %}#28a745{% else %}#6c757d{% endif %}; margin-right: 10px;"></span>
                            <span style="color: #8b5cf6;">Enable product properties</span>
                        </div>
                        <span style="color: {% if nostoConfig.enableProductProperties %}#28a745{% else %}#6c757d{% endif %}; font-weight: 500;">
                    {% if nostoConfig.enableProductProperties %}Enabled{% else %}Disabled{% endif %}
                </span>
                    </div>

                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <div style="display: flex; align-items: center;">
                            <span style="display: inline-block; width: 12px; height: 12px; border-radius: 50%; background-color: {% if nostoConfig.enableAlternateImages %}#28a745{% else %}#6c757d{% endif %}; margin-right: 10px;"></span>
                            <span style="color: #8b5cf6;">Enable Alternate Images</span>
                        </div>
                        <span style="color: {% if nostoConfig.enableAlternateImages %}#28a745{% else %}#6c757d{% endif %}; font-weight: 500;">
                    {% if nostoConfig.enableAlternateImages %}Enabled{% else %}Disabled{% endif %}
                </span>
                    </div>

                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <div style="display: flex; align-items: center;">
                            <span style="display: inline-block; width: 12px; height: 12px; border-radius: 50%; background-color: {% if nostoConfig.enableInventoryLevels %}#28a745{% else %}#6c757d{% endif %}; margin-right: 10px;"></span>
                            <span style="color: #8b5cf6;">Enable Inventory Levels</span>
                        </div>
                        <span style="color: {% if nostoConfig.enableInventoryLevels %}#28a745{% else %}#6c757d{% endif %}; font-weight: 500;">
                    {% if nostoConfig.enableInventoryLevels %}Enabled{% else %}Disabled{% endif %}
                </span>
                    </div>

                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <div style="display: flex; align-items: center;">
                            <span style="display: inline-block; width: 12px; height: 12px; border-radius: 50%; background-color: {% if nostoConfig.enableCustomerDataToNosto %}#28a745{% else %}#6c757d{% endif %}; margin-right: 10px;"></span>
                            <span style="color: #8b5cf6;">Send Customer Data To Nosto</span>
                        </div>
                        <span style="color: {% if nostoConfig.enableCustomerDataToNosto %}#28a745{% else %}#6c757d{% endif %}; font-weight: 500;">
                    {% if nostoConfig.enableCustomerDataToNosto %}Enabled{% else %}Disabled{% endif %}
                </span>
                    </div>

                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <div style="display: flex; align-items: center;">
                            <span style="display: inline-block; width: 12px; height: 12px; border-radius: 50%; background-color: {% if nostoConfig.enableSyncInactiveProducts %}#28a745{% else %}#6c757d{% endif %}; margin-right: 10px;"></span>
                            <span style="color: #8b5cf6;">Sync Inactive Products</span>
                        </div>
                        <span style="color: {% if nostoConfig.enableSyncInactiveProducts %}#28a745{% else %}#6c757d{% endif %}; font-weight: 500;">
                    {% if nostoConfig.enableSyncInactiveProducts %}Enabled{% else %}Disabled{% endif %}
                </span>
                    </div>

                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <div style="display: flex; align-items: center;">
                            <span style="display: inline-block; width: 12px; height: 12px; border-radius: 50%; background-color: {% if nostoConfig.enableProductPublishedDateTagging %}#28a745{% else %}#6c757d{% endif %}; margin-right: 10px;"></span>
                            <span style="color: #8b5cf6;">Enable Product Published Date Tagging</span>
                        </div>
                        <span style="color: {% if nostoConfig.enableProductPublishedDateTagging %}#28a745{% else %}#6c757d{% endif %}; font-weight: 500;">
                    {% if nostoConfig.enableProductPublishedDateTagging %}Enabled{% else %}Disabled{% endif %}
                </span>
                    </div>

                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <div style="display: flex; align-items: center;">
                            <span style="display: inline-block; width: 12px; height: 12px; border-radius: 50%; background-color: {% if nostoConfig.enableReloadRecommendations %}#28a745{% else %}#6c757d{% endif %}; margin-right: 10px;"></span>
                            <span style="color: #8b5cf6;">Reload Recommendations After Adding a recommended product</span>
                        </div>
                        <span style="color: {% if nostoConfig.enableReloadRecommendations %}#28a745{% else %}#6c757d{% endif %}; font-weight: 500;">
                    {% if nostoConfig.enableReloadRecommendations %}Enabled{% else %}Disabled{% endif %}
                </span>
                    </div>

                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <div style="display: flex; align-items: center;">
                            <span style="display: inline-block; width: 12px; height: 12px; border-radius: 50%; background-color: {% if nostoConfig.enableProductLabellingSync %}#28a745{% else %}#6c757d{% endif %}; margin-right: 10px;"></span>
                            <span style="color: #8b5cf6;">Enable Product Labelling Sync</span>
                        </div>
                        <span style="color: {% if nostoConfig.enableProductLabellingSync %}#28a745{% else %}#6c757d{% endif %}; font-weight: 500;">
                    {% if nostoConfig.enableProductLabellingSync %}Enabled{% else %}Disabled{% endif %}
                </span>
                    </div>

                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <div style="display: flex; align-items: center;">
                            <span style="display: inline-block; width: 12px; height: 12px; border-radius: 50%; background-color: {% if nostoConfig.enableStoreAbandonedCartData %}#28a745{% else %}#6c757d{% endif %}; margin-right: 10px;"></span>
                            <span style="color: #8b5cf6;">Store data for abandoned carts</span>
                        </div>
                        <span style="color: {% if nostoConfig.enableStoreAbandonedCartData %}#28a745{% else %}#6c757d{% endif %}; font-weight: 500;">
                    {% if nostoConfig.enableStoreAbandonedCartData %}Enabled{% else %}Disabled{% endif %}
                </span>
                    </div>

                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <div style="display: flex; align-items: center;">
                            <span style="display: inline-block; width: 12px; height: 12px; border-radius: 50%; background-color: {% if nostoConfig.enableIgnoreCookieConsent %}#28a745{% else %}#6c757d{% endif %}; margin-right: 10px;"></span>
                            <span style="color: #8b5cf6;">Ignore cookie consent</span>
                        </div>
                        <span style="color: {% if nostoConfig.enableIgnoreCookieConsent %}#28a745{% else %}#6c757d{% endif %}; font-weight: 500;">
                    {% if nostoConfig.enableIgnoreCookieConsent %}Enabled{% else %}Disabled{% endif %}
                </span>
                    </div>

                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <div style="display: flex; align-items: center;">
                            <span style="display: inline-block; width: 12px; height: 12px; border-radius: 50%; background-color: {% if nostoConfig.enableSyncFirstAvailableVariant %}#28a745{% else %}#6c757d{% endif %}; margin-right: 10px;"></span>
                            <span style="color: #8b5cf6;">Sync first available variant as a product, if product is on clearance and out of stock</span>
                        </div>
                        <span style="color: {% if nostoConfig.enableSyncFirstAvailableVariant %}#28a745{% else %}#6c757d{% endif %}; font-weight: 500;">
                    {% if nostoConfig.enableSyncFirstAvailableVariant %}Enabled{% else %}Disabled{% endif %}
                </span>
                    </div>

                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <div style="display: flex; align-items: center;">
                            <span style="display: inline-block; width: 12px; height: 12px; border-radius: 50%; background-color: {% if nostoConfig.dailyProductSyncEnabled %}#28a745{% else %}#6c757d{% endif %}; margin-right: 10px;"></span>
                            <span style="color: {% if nostoConfig.dailyProductSyncEnabled %}#8b5cf6{% else %}#6c757d{% endif %};">Enable Daily Product Synchronization</span>
                        </div>
                        <span style="color: {% if nostoConfig.dailyProductSyncEnabled %}#28a745{% else %}#6c757d{% endif %}; font-weight: 500;">
                    {% if nostoConfig.dailyProductSyncEnabled %}Enabled{% else %}Disabled{% endif %}
                </span>
                    </div>

                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <div style="display: flex; align-items: center;">
                            <span style="display: inline-block; width: 12px; height: 12px; border-radius: 50%; background-color: {% if nostoConfig.oldJobCleanupEnabled %}#28a745{% else %}#6c757d{% endif %}; margin-right: 10px;"></span>
                            <span style="color: {% if nostoConfig.oldJobCleanupEnabled %}#8b5cf6{% else %}#6c757d{% endif %};">Enable cleanup of old jobs</span>
                        </div>
                        <span style="color: {% if nostoConfig.oldJobCleanupEnabled %}#28a745{% else %}#6c757d{% endif %}; font-weight: 500;">
                    {% if nostoConfig.oldJobCleanupEnabled %}Enabled{% else %}Disabled{% endif %}
                </span>
                    </div>

                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <div style="display: flex; align-items: center;">
                            <span style="display: inline-block; width: 12px; height: 12px; border-radius: 50%; background-color: {% if nostoConfig.oldNostoDataCleanupEnabled %}#28a745{% else %}#6c757d{% endif %}; margin-right: 10px;"></span>
                            <span style="color: {% if nostoConfig.oldNostoDataCleanupEnabled %}#8b5cf6{% else %}#6c757d{% endif %};">Enable cleanup of old Nosto data</span>
                        </div>
                        <span style="color: {% if nostoConfig.oldNostoDataCleanupEnabled %}#28a745{% else %}#6c757d{% endif %}; font-weight: 500;">
                    {% if nostoConfig.oldNostoDataCleanupEnabled %}Enabled{% else %}Disabled{% endif %}
                </span>
                    </div>

                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <div style="display: flex; align-items: center;">
                            <span style="display: inline-block; width: 12px; height: 12px; border-radius: 50%; background-color: {% if nostoConfig.enableSearchImpressions %}#28a745{% else %}#6c757d{% endif %}; margin-right: 10px;"></span>
                            <span style="color: #8b5cf6;">Send Search & Category analytics</span>
                        </div>
                        <span style="color: {% if nostoConfig.enableSearchImpressions %}#28a745{% else %}#6c757d{% endif %}; font-weight: 500;">
                    {% if nostoConfig.enableSearchImpressions %}Enabled{% else %}Disabled{% endif %}
                </span>
                    </div>
                </div>
            </div>
        </div>

        <form id="nosto-logs" action="{{ path('nosto-monitoring.logs') }}" method="GET">
            <button type="submit" class="nosto-button">Logs</button>
        </form>
        <form id="nosto-download-logs">
            <button onclick="handleLogsDownload()" class="nosto-button">Download log files</button>
        </form>

        <!-- Debug Resources Section -->
        <div style="background: white; border: 1px solid #dee2e6; border-radius: 8px; margin-top: 20px; padding: 20px;">
            <h3 style="margin: 0 0 20px 0; color: #6c757d; font-size: 18px;">Debug Resources</h3>

            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px;">
                <!-- Product Debug Form -->
                <div>
                    <form action="{{ path('nosto-monitoring.show-product') }}" method="POST">
                        <div style="margin-bottom: 15px;">
                            <label style="color: #007bff; font-weight: 500; display: block; margin-bottom: 8px;">Product ID</label>
                            <input
                                    type="text"
                                    name="productId"
                                    style="width: 100%; padding: 8px 12px; border: 1px solid #e9ecef; border-radius: 4px; background: #fff;"
                                    placeholder="Enter product ID"
                                    required
                            >
                        </div>
                        <button type="submit" class="nosto-button" style="width: 100%;">Show Product</button>
                    </form>
                </div>

                <!-- Category Debug Form -->
                <div>
                    <form action="{{ path('nosto-monitoring.show-category') }}" method="POST">
                        <div style="margin-bottom: 15px;">
                            <label style="color: #007bff; font-weight: 500; display: block; margin-bottom: 8px;">Category ID</label>
                            <input
                                    type="text"
                                    name="categoryId"
                                    style="width: 100%; padding: 8px 12px; border: 1px solid #e9ecef; border-radius: 4px; background: #fff;"
                                    placeholder="Enter category ID"
                                    required
                            >
                        </div>
                        <button type="submit" class="nosto-button" style="width: 100%;">Show Category</button>
                    </form>
                </div>

                <!-- Order Debug Form -->
                <div>
                    <form action="{{ path('nosto-monitoring.show-order') }}" method="POST">
                        <div style="margin-bottom: 15px;">
                            <label style="color: #007bff; font-weight: 500; display: block; margin-bottom: 8px;">Order ID</label>
                            <input
                                    type="text"
                                    name="orderId"
                                    style="width: 100%; padding: 8px 12px; border: 1px solid #e9ecef; border-radius: 4px; background: #fff;"
                                    placeholder="Enter order ID"
                                    required
                            >
                        </div>
                        <button type="submit" class="nosto-button" style="width: 100%;">Show Order</button>
                    </form>
                </div>
            </div>
        </div>

    </div>

    <script>
        window.router['nosto-monitoring.log-download-all'] = '{{ path('nosto-monitoring.log-download-all') }}';
        async function detectIncognito() {
            return new Promise(function (resolve, reject) {
                let browserName = 'Unknown';

                function __callback(isPrivate) {
                    resolve({
                        isPrivate,
                        browserName
                    });
                }

                function identifyChromium() {
                    const ua = navigator.userAgent;
                    if (ua.match(/Chrome/)) {
                        if (navigator.brave !== undefined) {
                            return 'Brave';
                        } else if (ua.match(/Edg/)) {
                            return 'Edge';
                        } else if (ua.match(/OPR/)) {
                            return 'Opera';
                        }
                        return 'Chrome';
                    } else {
                        return 'Chromium';
                    }
                }

                function feid() {
                    let toFixedEngineID = 0;
                    try {
                        eval('(-1).toFixed(-1);');
                    } catch (e) {
                        toFixedEngineID = e.message.length; // Safari 44, Chrome 51, Firefox 25
                    }
                    return toFixedEngineID;
                }

                function isSafari() {
                    return feid() === 44;
                }

                function isChrome() {
                    return feid() === 51;
                }

                function isFirefox() {
                    return feid() === 25;
                }

                function isMSIE() {
                    return (
                        navigator.msSaveBlob !== undefined &&
                        eval.toString().length === 39
                    );
                }

                function newSafariTest() {
                    const tmp_name = String(Math.random());

                    try {
                        const db = window.indexedDB.open(tmp_name, 1);

                        db.onupgradeneeded = function (i) {
                            const res = i.target.result;

                            try {
                                res.createObjectStore('test', { autoIncrement: true }).put(new Blob());
                                __callback(false);
                            } catch (e) {
                                const message = e.message || e;
                                const matchesExpectedError = message.includes('BlobURLs are not yet supported');
                                __callback(matchesExpectedError);
                            } finally {
                                res.close();
                                window.indexedDB.deleteDatabase(tmp_name);
                            }
                        };
                    } catch (e) {
                        __callback(false);
                    }
                }

                function oldSafariTest() {
                    const openDB = window.openDatabase;
                    const storage = window.localStorage;

                    try {
                        openDB(null, null, null, null);
                    } catch (e) {
                        __callback(true);
                        return;
                    }

                    try {
                        storage.setItem('test', '1');
                        storage.removeItem('test');
                    } catch (e) {
                        __callback(true);
                        return;
                    }

                    __callback(false);
                }

                function safariPrivateTest() {
                    if (navigator.maxTouchPoints !== undefined) {
                        newSafariTest();
                    } else {
                        oldSafariTest();
                    }
                }

                function getQuotaLimit() {
                    if (
                        performance.memory &&
                        performance.memory.jsHeapSizeLimit
                    ) {
                        return performance.memory.jsHeapSizeLimit;
                    }
                    return 1073741824;
                }

                function storageQuotaChromePrivateTest() {
                    navigator.webkitTemporaryStorage.queryUsageAndQuota(
                        function (_, quota) {
                            const quotaInMib = Math.round(quota / (1024 * 1024));
                            const quotaLimitInMib = Math.round(getQuotaLimit() / (1024 * 1024)) * 2;

                            __callback(quotaInMib < quotaLimitInMib);
                        },
                        function (e) {
                            reject(
                                new Error(
                                    'detectIncognito failed to query storage quota: ' +
                                    e.message
                                )
                            );
                        }
                    );
                }

                function oldChromePrivateTest() {
                    const fs = window.webkitRequestFileSystem;
                    fs(0, 1, function () {
                        __callback(false);
                    }, function () {
                        __callback(true);
                    });
                }

                function chromePrivateTest() {
                    if (self.Promise && self.Promise.allSettled) {
                        storageQuotaChromePrivateTest();
                    } else {
                        oldChromePrivateTest();
                    }
                }

                function firefoxPrivateTest() {
                    __callback(navigator.serviceWorker === undefined);
                }

                function msiePrivateTest() {
                    __callback(window.indexedDB === undefined);
                }

                function main() {
                    if (isSafari()) {
                        browserName = 'Safari';
                        safariPrivateTest();
                    } else if (isChrome()) {
                        browserName = identifyChromium();
                        chromePrivateTest();
                    } else if (isFirefox()) {
                        browserName = 'Firefox';
                        firefoxPrivateTest();
                    } else if (isMSIE()) {
                        browserName = 'Internet Explorer';
                        msiePrivateTest();
                    } else {
                        reject(new Error('detectIncognito cannot determine the browser'));
                    }
                }

                main();
            });
        }

        if (typeof window !== 'undefined') {
            window.detectIncognito = detectIncognito;
        }

        async function handleLogsDownload() {
            const result = await window.detectIncognito();

            if (result.isPrivate) {
                alert('Downloading log files is not allowed in incognito mode.');
                return;
            }

            const apiRoute = window.router['nosto-monitoring.log-download-all'];

            const downloadUrl = window.location.origin + apiRoute;

            const a = document.createElement('a');
            a.href = downloadUrl;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }
    </script>
{% endblock %}
